# CRLF sólo donde Windows lo exige; los .sh deben quedar en LF o bash
# los rechaza con "bad interpreter: /bin/bash^M" en Linux.
*.sh   text eol=lf
*.bash text eol=lf

# El wrapper de Maven no tiene extensión, así que `*.sh` no lo cubre.
# Igual debe quedar en LF: es un shell script. Sin la barra inicial porque
# los wrappers viven en backend/<servicio>/, no en la raíz del repo.
mvnw text eol=lf

# Scripts y ejecutables de Windows
*.ps1  text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

# Configuración y fuentes: LF en todo el repo
*.java text eol=lf
*.ts   text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.xml  text eol=lf
*.conf text eol=lf
*.md   text eol=lf
