# Dependencias y build del frontend
node_modules/
dist/
.angular/
.sass-cache/

# Build de Java
**/target/
# `build/` también (lo ignoraban los .gitignore por módulo). Las excepciones
# evitan pisar los recursos que Spring Boot deja bajo src/main y src/test.
**/build/
!**/src/main/**/build/
!**/src/test/**/build/

# Archivos de entorno con secretos reales (sólo se versiona el ejemplo)
.env
.env.*
!.env.example

# Logs de crash de la JVM generados en desarrollo local
hs_err_pid*.log
replay_pid*.log
*.hprof

# Salidas sueltas de depuración
out.html
nohup.out
__screenshots__/

# IDE
.idea/
.vscode/
*.iml
.classpath
.project
.factorypath
.settings/
.c9/
*.launch
*.sublime-workspace

# Sistema
.DS_Store
Thumbs.db
