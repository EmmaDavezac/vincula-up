{
  "realm": "vincula-up",
  "enabled": true,
  "internationalizationEnabled": true,
  "supportedLocales": ["es"],
  "defaultLocale": "es",
  "sslRequired": "none",
  "smtpServer": {
    "host": "smtp.gmail.com",
    "port": "587",
    "from": "",
    "fromDisplayName": "Vincula-UP",
    "replyTo": "",
    "starttls": "true",
    "auth": "true",
    "user": "",
    "password": ""
  },
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": false,
  "resetPasswordAllowed": true,
  "defaultRoles": ["CLIENTE"],
  "roles": {
    "realm": [
      { "name": "CLIENTE" },
      { "name": "PROFESIONAL" },
      { "name": "ADMIN" }
    ]
  },
  "clients": [
    {
      "clientId": "vincula-up-public",
      "name": "Vincula-UP Public Client",
      "description": "Client público del frontend (PKCE S256, sin secreto). El redirectUris incluye https://* para que los túneles de Cloudflare de demo funcionen sin reconfigurar el client cada vez que cloudflared genera una URL nueva: Keycloak sólo matchea comodines al final del patrón, así que https://*.trycloudflare.com/* NO funcionaría. En producción reemplazar https://* por el dominio real.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost/*",
        "http://localhost:4200/*",
        "https://vincula-up.local/*",
        "http://127.0.0.1/*",
        "http://127.0.0.1:4200/*",
        "https://*"
      ],
      "webOrigins": [
        "*"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "vincula-up-admin",
      "name": "Vincula-UP Admin Service Account",
      "description": "Client de servicio del BFF: promueve a PROFESIONAL al profesional invitado que se auto-registra en Keycloak con el email cargado por el administrador.",
      "enabled": true,
      "publicClient": false,
      "secret": "vincula-up-admin-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "id": "11111111-1111-1111-1111-111111111111",
      "username": "cliente@vincula-up.local",
      "enabled": true,
      "email": "cliente@vincula-up.local",
      "firstName": "Sofia",
      "lastName": "Gomez",
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "password", "temporary": false }
      ],
      "realmRoles": ["CLIENTE"]
    },
    {
      "id": "22222222-2222-2222-2222-222222222222",
      "username": "profesional@vincula-up.local",
      "enabled": true,
      "email": "profesional@vincula-up.local",
      "firstName": "Luciano",
      "lastName": "Benitez",
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "password", "temporary": false }
      ],
      "realmRoles": ["PROFESIONAL"]
    },
    {
      "id": "33333333-3333-3333-3333-333333333333",
      "username": "admin@vincula-up.local",
      "enabled": true,
      "email": "admin@vincula-up.local",
      "firstName": "Admin",
      "lastName": "Vincula-UP",
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "password", "temporary": false }
      ],
      "realmRoles": ["ADMIN"]
    },
    {
      "username": "service-account-vincula-up-admin",
      "enabled": true,
      "serviceAccountClientId": "vincula-up-admin",
      "clientRoles": {
        "realm-management": ["manage-users", "view-users", "query-users", "view-realm"]
      }
    }
  ]
}
