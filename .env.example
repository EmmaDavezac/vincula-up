# ==========================================================================
#  Variables de entorno - Vincula-UP
# ==========================================================================
#
#  COMO USARLO
#    1. cp .env.example .env       (Linux)   |   Copy-Item .env.example .env (Windows)
#    2. Edita .env con tus valores.
#    3. docker compose up --build
#
#  Si te pasaron un .env ya configurado (por ejemplo el de otra persona del
#  equipo, con los secretos puestos), NO copies este archivo: poné ese .env en
#  la raíz del proyecto y listo. Este .env.example es solo la plantilla vacía.
#
#  Este archivo (.env.example) SI se versiona: es la plantilla. Tu .env con las
#  credenciales reales NO se versiona nunca (esta en .gitignore).
#
#  --------------------------------------------------------------------------
#  1. BASE DE DATOS (PostgreSQL)
#  --------------------------------------------------------------------------
#  Los cuatro componentes (ms-usuarios, ms-profesionales, ms-solicitudes y
#  Keycloak) comparten esta misma base. Un volumen Docker la persiste entre
#  reinicios; `docker compose down -v` la borra.
POSTGRES_DB=vinculaup              # Nombre de la base; se crea al primer arranque.
POSTGRES_USER=postgres             # Usuario dueno de la base.
POSTGRES_PASSWORD=postgres         # SOLO PARA DEMO. Cambiar antes de exponer la base.

# Lo que leen los microservicios. La URL usa el nombre del servicio de Docker
# (postgres), no localhost: dentro de la red de contenedores el host es otro.
DATABASE_URL=jdbc:postgresql://postgres:5432/vinculaup
DATABASE_USERNAME=postgres         # Debe coincidir con POSTGRES_USER.
DATABASE_PASSWORD=postgres         # SOLO PARA DEMO. Debe coincidir con POSTGRES_PASSWORD.

# Como se crea o actualiza el esquema de la base.
#   update   -> Hibernate crea y altera las tablas al arrancar. Comodo, pero no
#              versiona el esquema: no hay forma de reproducir una base ni de
#              revertir un cambio de modelo.
#   validate -> no toca nada; falla si el esquema no coincide.
# PENDIENTE: migrar a Flyway/Liquibase antes de produccion.
JPA_DDL_AUTO=update

# --------------------------------------------------------------------------
#  2. KEYCLOAK (identidad y single sign-on)
#  --------------------------------------------------------------------------
# Realm = espacio de trabajo con sus usuarios, roles y clientes. Se define en
# keycloak/import/vincula-up-realm.json y se importa al primer arranque.
KEYCLOAK_REALM=vincula-up           # Nombre del realm.

# URL publica de la aplicacion. Keycloak la usa para armar los enlaces de
# login y logout.
# Dejala VACIA para que Keycloak resuelva el hostname desde el request: asi las
# URLs que genera (issuer, enlaces) salen con el host por el que realmente se
# entra, que es lo que hace funcionar los tuneles de Cloudflare (su hostname
# cambia cada vez que se levanta cloudflared). Ver riesgo #4 de ESPECIFICACION.md.
# Fijala solo si publicas con un dominio propio y estable (ej: app.midominio.com).
KEYCLOAK_HOSTNAME=
KEYCLOAK_ISSUER_URI=http://keycloak:8080/realms/vincula-up   # Solo red interna.

# Cuenta de emergencia de Keycloak (la que usas para entrar a la consola de
# administracion). Es una cuenta aparte de las de la aplicacion.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin      # SOLO PARA DEMO.

# Client de servicio: cuenta con permisos que usa el BFF para promover a
# PROFESIONAL a un profesional invitado, en su primer ingreso.
KEYCLOAK_ADMIN_BASE_URL=http://keycloak:8080      # Solo red interna.
KEYCLOAK_ADMIN_CLIENT_ID=vincula-up-admin
# Como llega el secreto a los dos lados que tienen que coincidir:
#   1. al BFF, por docker-compose.yml
#   2. a Keycloak, por scripts/*/keycloak-bootstrap.sh|ps1
# El JSON de keycloak/import/ NO lee esta variable: ver keycloak/import/README.md.
#
# VACIO: rige el default de demo "vincula-up-admin-secret", que es PUBLICO (esta
#   en el repositorio). El stack funciona, pero quien conozca el repo puede pedir
#   un token de servicio y promover cuentas a PROFESIONAL. Aceptable en local;
#   rotar antes de exponer el stack.
#
# PARA ROTARLO:
#   1. openssl rand -hex 24   y pegar el resultado en la linea de abajo.
#   2. Re-correr el bootstrap (es lo unico que lo copia a Keycloak):
#        ./scripts/linux-macos/keycloak-bootstrap.sh
#        powershell -ExecutionPolicy Bypass -File .\scripts\windows\keycloak-bootstrap.ps1
#   3. Recrear el BFF para que lea el valor nuevo:
#        docker compose up -d --force-recreate bff-web
KEYCLOAK_ADMIN_CLIENT_SECRET=

# --------------------------------------------------------------------------
#  3. pgADMIN (consola web para ver la base de datos)
#  --------------------------------------------------------------------------
# Credenciales de la consola web de pgAdmin, no de la aplicacion.
# El dominio NO puede ser .local: pgAdmin 8.12 exige un TLD real (com, net, org).
PGADMIN_DEFAULT_EMAIL=admin@vincula-up.com
PGADMIN_DEFAULT_PASSWORD=admin      # SOLO PARA DEMO.

# --------------------------------------------------------------------------
#  4. ALMACENAMIENTO DE FOTOS DE PERFIL
#  --------------------------------------------------------------------------
# Las fotos viven en un volumen en disco (fotos_data) que solo monta el BFF.
# No hay bucket ni servicio de objetos.
#
# La base guarda solo la CLAVE del archivo (STORAGE_PREFIX/<uuid>.jpg), nunca una
# URL. Las fotos no son publicas: se piden a GET /api/usuarios/{id}/foto, que
# exige sesion y decide por rol quien ve la foto de quien (un cliente ve las de
# los profesionales, un profesional las de los clientes, el administrador las de
# ambos, y nadie ve las de su mismo rol).
STORAGE_PREFIX=perfiles            # Carpeta dentro del volumen donde se agrupan.
STORAGE_MAX_BYTES=2097152          # Tamano maximo de una foto: 2 MiB en bytes.
# STORAGE_LOCAL_DIR no se toca: la fija docker-compose.yml en /data/fotos, que es
# donde esta montado el volumen.

# --------------------------------------------------------------------------
#  5. CIFRADO DE COORDENADAS
#  --------------------------------------------------------------------------
# Las coordenadas de los domicilios y zonas de cobertura se cifran en reposo
# con AES-256-GCM. Genera una clave de 32 bytes en Base64:
#   openssl rand -base64 32
# Sin esta variable los servicios arrancan igual, pero guardan SIN cifrar.
# Perder la clave deja ilegibles las coordenadas ya guardadas.
UBICACIONES_CLAVE=

# --------------------------------------------------------------------------
#  6. CORREO (SMTP) - recuperacion de contrasena y aviso de prerregistro
#  --------------------------------------------------------------------------
# El MISMO servidor lo usan Keycloak (para "olvide mi contrasena") y el BFF
# (para avisarle al profesional que fue prerregistrado). No hace falta
# configurar un SMTP aparte.
#
# Gmail: usa una CONTRASENA DE APLICACION, no la de la cuenta.
#   Cuenta Google -> Seguridad -> Verificacion en 2 pasos -> Contrasenas de aplicacion.
KEYCLOAK_SMTP_HOST=smtp.gmail.com   # Host del servidor SMTP.
KEYCLOAK_SMTP_PORT=587              # 587 con STARTTLS (lo habitual). 465 es implicito.
KEYCLOAK_SMTP_STARTTLS=true         # Negocia cifrado TLS al conectar.
KEYCLOAK_SMTP_AUTH=true            # Requiere usuario y contrasena.
KEYCLOAK_SMTP_USER=admin@vincula-up.local   # Cuenta de correo. VACIO = sin envio.
KEYCLOAK_SMTP_PASSWORD=             # Contrasena de aplicacion. VACIO = sin envio.
KEYCLOAK_SMTP_FROM=admin@vincula-up.local   # Remitente (From).
KEYCLOAK_SMTP_FROM_DISPLAY_NAME=Vincula-UP # Nombre que se ve en la bandeja.

# URL que se pone en el enlace del correo de prerregistro, para que el
# profesional entre directo a activar su perfil.
APP_URL=https://vincula-up.local

# --------------------------------------------------------------------------
#  7. DATOS DE DEMO
#  --------------------------------------------------------------------------
# true  -> al arrancar se siembran especialidades, un profesional de ejemplo y
#          cuatro solicitudes en distintos estados (con mensajes y una
#          calificacion), para que los listados no se vean vacios.
# false -> la base arranca vacia. Los usuarios siguen creandose solos al
#          registrarse e ingresar por primera vez; lo que no aparece es el
#          contenido de ejemplo.
#
# Para cambiarlo en una base ya creada hay que recrearla:
#   SEMBRAR_DEMO=false y docker compose down -v && docker compose up --build
SEMBRAR_DEMO=true
