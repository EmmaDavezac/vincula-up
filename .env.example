POSTGRES_DB=vinculaup
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=jdbc:postgresql://postgres:5432/vinculaup
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
JPA_DDL_AUTO=update
KEYCLOAK_ISSUER_URI=http://keycloak:8080/realms/vincula-up
KEYCLOAK_HOSTNAME=localhost
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=vincula-up
KEYCLOAK_ADMIN_BASE_URL=http://keycloak:8080
KEYCLOAK_ADMIN_CLIENT_ID=vincula-up-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=vincula-up-admin-secret
PGADMIN_DEFAULT_EMAIL=admin@vincula-up.com
PGADMIN_DEFAULT_PASSWORD=admin

# Almacenamiento de fotos. La base solo guarda la URL, nunca el archivo.
#   local (default) -> un volumen en disco. No necesita ningún servicio extra.
#   s3              -> MinIO o Cloudflare R2, vía API compatible con S3.
# Para usar s3: descomentar el bloque de MinIO en docker-compose.yml (o apuntar
# a un bucket de R2) y completar las variables STORAGE_* de abajo.
STORAGE_TIPO=local
STORAGE_LOCAL_DIR=/data/fotos
# Con local, es la ruta donde nginx sirve el volumen.
STORAGE_PUBLIC_URL=/fotos
STORAGE_PREFIX=perfiles
STORAGE_MAX_BYTES=2097152

# Solo con STORAGE_TIPO=s3 (MinIO autohospedado o Cloudflare R2).
# Para Cloudflare R2: STORAGE_ENDPOINT=https://<account>.r2.cloudflarestorage.com
MINIO_ROOT_USER=vinculaminio
MINIO_ROOT_PASSWORD=vinculaminio123
STORAGE_ENDPOINT=http://minio:9000
STORAGE_ACCESS_KEY=vinculaminio
STORAGE_SECRET_KEY=vinculaminio123
STORAGE_BUCKET=vincula-up-media

# Cifrado AES-256-GCM de las coordenadas en reposo. Generar con:
#   openssl rand -base64 32
# Sin esta variable los servicios arrancan igual, pero guardan sin cifrar.
UBICACIONES_CLAVE=

# SMTP de Keycloak (recuperación de contraseña y verificación de email).
# Gmail: usar una contraseña de aplicación, no la contraseña de la cuenta.
# Cuenta Google → Seguridad → Verificación en 2 pasos → Contraseñas de aplicación.
KEYCLOAK_SMTP_HOST=smtp.gmail.com
KEYCLOAK_SMTP_PORT=587
KEYCLOAK_SMTP_STARTTLS=true
KEYCLOAK_SMTP_AUTH=true
KEYCLOAK_SMTP_USER=admin@vincula-up.local
KEYCLOAK_SMTP_PASSWORD=
KEYCLOAK_SMTP_FROM=admin@vincula-up.local
KEYCLOAK_SMTP_FROM_DISPLAY_NAME=Vincula-UP
